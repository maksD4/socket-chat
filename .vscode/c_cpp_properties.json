{
    "version": 4,
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}",
                "${workspaceFolder}/hiredis",                // where hiredis.h is
                "/usr/include/libmongoc-1.0",
                "/usr/include/libbson-1.0"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "/usr/include/libmongoc-1.0",
                    "/usr/include/libbson-1.0"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}
